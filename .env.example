NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Checkout (sólo servidor; nunca con prefijo NEXT_PUBLIC_).
# Mercado Pago, API de Órdenes: credenciales de la app en Tus integraciones (de prueba
# en desarrollo). La clave secreta de notificaciones sale de Webhooks > Configurar
# notificaciones, evento «Order (Mercado Pago)», URL https://<dominio>/api/mercadopago/webhook.
MP_ACCESS_TOKEN=APP_USR-...
MP_WEBHOOK_SECRET=...
# Firma los enlaces privados a los recibos: al menos 32 caracteres al azar.
# Cambiarla invalida todos los enlaces ya enviados.
RECEIPT_SECRET=...
# Origen público de la tienda, para las vueltas de Mercado Pago y los correos.
SITE_URL=https://tu-dominio
# Opcional: sin estas dos no se manda correo y el recibo lo dice.
RESEND_API_KEY=re_...
RESEND_FROM=Hilo <pedidos@tu-dominio>
